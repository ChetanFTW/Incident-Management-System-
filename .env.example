# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=ims
POSTGRES_PASSWORD=imspass
POSTGRES_DB=imsdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ims:imspass@postgres:5432/imsdb

# ── MongoDB ───────────────────────────────────────────────────
MONGO_USER=ims
MONGO_PASSWORD=imspass
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=imsdb
MONGO_URL=mongodb://ims:imspass@mongo:27017/imsdb?authSource=admin

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=imspass
REDIS_URL=redis://:imspass@redis:6379/0

# ── JWT Auth ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_SIGNALS_PER_SECOND=10000
RATE_LIMIT_API_PER_MINUTE=1000

# ── Ingestion ─────────────────────────────────────────────────
DEBOUNCE_WINDOW_SECONDS=10
DEBOUNCE_MAX_SIGNALS=100
QUEUE_MAX_SIZE=50000

# ── Observability ─────────────────────────────────────────────
METRICS_INTERVAL_SECONDS=5

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
